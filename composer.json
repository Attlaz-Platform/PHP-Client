{
  "name": "attlaz/client",
  "description": "Attlaz PHP Client | Attlaz - solutions & tools for cloud connected businesses, automation and scaling",
  "type": "library",
  "keywords": [
    "attlaz",
    "ipaas",
    "connection",
    "synchronize"
  ],
  "license": "MIT",
  "homepage": "https://attlaz.com",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.4.5",
    "league/oauth2-client": "^2.7.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9 | ^10",
    "vlucas/phpdotenv": "v5.6.2",
    "phpstan/phpstan": "^2.2.2"
  },
  "scripts": {
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=512M",
    "phpstan:generate-baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=512M"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\": "tests/"
    }
  }
}
